// Co-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The caller currently belongs to the household [id], according to its memberIds (the source of
    // truth). A private fridge also requires its creator. A missing type is treated as shared.
    function isCurrentMember(id) {
      let home = firestore.get(/databases/(default)/documents/households/$(id)).data;
      let sharedFridgeType = 'SHARED';
      let privateFridgeType = 'PRIVATE';
      return request.auth.uid in home.memberIds
          && (home.get('type', sharedFridgeType) != privateFridgeType
              || home.createdBy == request.auth.uid);
    }

    // Photos follow their item, as in firestore.rules: only current members of the item's household
    // may use them, and only the owner for a PERSONAL item. Access follows the current membership
    // even for the owner, so a user who left the household can no longer reach their old photos.
    function canAccessItem(id, photo) {
      let item = firestore.get(/databases/(default)/documents/items/$(id)).data;
      let ownerIdMetadataKey = 'itemOwnerId';
      let sharedItemSharing = 'SHARED';
      // ownerId is immutable in Firestore. Reusing a deleted ID as another owner must not
      // grant access to the old photo. Null resources preserve authorized "not found" responses.
      return (photo == null || photo.metadata.get(ownerIdMetadataKey, '') == item.ownerId)
          && item.get('householdId', null) is string
          && isCurrentMember(item.householdId)
          && (item.ownerId == request.auth.uid || item.get('sharing', null) == sharedItemSharing);
    }
    match /itemPhotos/{itemId}/{photoId} {
      allow get, delete: if request.auth != null && canAccessItem(itemId, resource);
      function hasValidPhotoData() {
        let photoIdPattern = '[a-f0-9-]{36}';
        let maxPhotoBytes = 5 * 1024 * 1024;
        let photoContentTypes = ['image/jpeg', 'image/png'];
        return photoId.matches(photoIdPattern)
            && request.resource.size > 0 && request.resource.size <= maxPhotoBytes
            && request.resource.contentType in photoContentTypes;
      }

      // Objects are immutable; replacing a photo creates a fresh identifier.
      allow create: if resource == null && request.auth != null
          && canAccessItem(itemId, request.resource)
          && hasValidPhotoData();
      // No listing, overwrite, metadata update or access to any other path.
    }
  }
}
