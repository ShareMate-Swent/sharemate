// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>
// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /receiptPhotos/{householdId}/{ownerId}/{fileName} {
      function receipt() {
        let id = fileName.replace('[.]jpg$', '');
        return firestore.get(/databases/(default)/documents/receiptBackups/$(id)).data;
      }
      allow get: if request.auth != null && isCurrentMember(householdId)
          && receipt().ownerId == ownerId && receipt().householdId == householdId
          && (request.auth.uid == ownerId || receipt().draft == false);
      allow create, update: if request.auth != null && request.auth.uid == ownerId
          && isCurrentMember(householdId) && receipt().ownerId == ownerId
          && receipt().householdId == householdId
          && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png'];
    }
    function hasValidPhotoData() {
      let maxPhotoBytes = 5 * 1024 * 1024;
      let photoContentTypes = ['image/jpeg', 'image/png'];
      return request.resource.size > 0 && request.resource.size <= maxPhotoBytes
          && request.resource.contentType in photoContentTypes;
    }

    function incidentSegmentPattern() {
      return '[A-Za-z0-9_:-]+';
    }

    function incidentPhotoIdPattern() {
      return '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';
    }

    // The caller currently belongs to the household [id], according to its memberIds (the source of
    // truth). A private fridge also requires its creator. A missing type is treated as shared.
    function isCurrentMember(id) {
      let home = firestore.get(/databases/(default)/documents/households/$(id)).data;
      let sharedFridgeType = 'SHARED';
      let privateFridgeType = 'PRIVATE';
      return request.auth.uid in home.memberIds
          && (home.get('type', sharedFridgeType) != privateFridgeType
              || home.createdBy == request.auth.uid);
    }

    // Photos follow their item, as in firestore.rules: only current members of the item's household
    // may use them, and only the owner for a PERSONAL item. Access follows the current membership
    // even for the owner, so a user who left the household can no longer reach their old photos.
    function canAccessItem(id, photo) {
      let item = firestore.get(/databases/(default)/documents/items/$(id)).data;
      let ownerIdMetadataKey = 'itemOwnerId';
      let sharedItemSharing = 'SHARED';
      // ownerId is immutable in Firestore. Reusing a deleted ID as another owner must not
      // grant access to the old photo. Null resources preserve authorized "not found" responses.
      return (photo == null || photo.metadata.get(ownerIdMetadataKey, '') == item.ownerId)
          && item.get('householdId', null) is string
          && isCurrentMember(item.householdId)
          && (item.ownerId == request.auth.uid || item.get('sharing', null) == sharedItemSharing);
    }
    match /itemPhotos/{itemId}/{photoId} {
      allow get, delete: if request.auth != null && canAccessItem(itemId, resource);
      function hasValidItemPhotoData() {
        let photoIdPattern = '[a-f0-9-]{36}';
        return photoId.matches(photoIdPattern)
            && hasValidPhotoData();
      }

      // Objects are immutable; replacing a photo creates a fresh identifier.
      allow create: if resource == null && request.auth != null
          && canAccessItem(itemId, request.resource)
          && hasValidItemPhotoData();
      // No listing, overwrite, metadata update or access to any other path.
    }

    // Incident references are immutable. Membership is checked on each authenticated operation.
    match /incidentPhotos/{householdId}/{authorId}/{photoId} {
      function validIncidentPath() {
        return householdId.matches(incidentSegmentPattern())
            && authorId.matches(incidentSegmentPattern())
            && photoId.matches(incidentPhotoIdPattern());
      }
      allow get: if request.auth != null && validIncidentPath() && isCurrentMember(householdId);
      allow create: if resource == null && request.auth != null && validIncidentPath()
          && authorId == request.auth.uid && isCurrentMember(householdId)
          && hasValidPhotoData();
      // No list, update (including overwrite/metadata), or client-side delete permission.
    }

    // Profile photos: each upload gets a new path, so the previous photo stays readable until the
    // account photo URL points at the new one; the owner then deletes the older ones. Only the
    // owner can read them through the SDK, list or delete them. The tokenised download URL, shared
    // as the account photo URL, is readable by anyone who has it.
    match /users/{uid}/avatars/{photoId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow get, list, delete: if isOwner();
      // Photos are never overwritten: a replacement is a new object.
      allow create: if resource == null && isOwner() && hasValidPhotoData();
      // No update and no access to any other path under users/.
    }
  }
}
