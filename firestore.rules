// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>
// Co-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function documentPath(collection, documentId) {
      return /databases/$(database)/documents/$(collection)/$(documentId);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function privateFridgeType() {
      return 'PRIVATE';
    }

    function sharedFridgeType() {
      return 'SHARED';
    }

    // Private access follows the immutable creator.
    function canAccessFridge(household) {
      return household.type != privateFridgeType()
          || household.createdBy == request.auth.uid;
    }

    function hasValidPrivateMembers(household) {
      return household.type != privateFridgeType()
          || household.memberIds.hasOnly([household.createdBy]);
    }

    // A user profile is private to its owner.
    match /users/{userId} {
      function optionalIntInRange(values, field, low, high) {
        return !(field in values)
            || (values[field] is int && values[field] >= low && values[field] <= high);
      }

      // Expiry reminder preferences. They are optional, and every field of the map is optional
      // too, because the app saves one field at a time. The ranges mirror ExpirationPreferences:
      // soon window 1-60 days, repeat every 1-30 days, with 0 standing for "never".
      function hasValidExpirationPreferences(data) {
        let preferences = data.get('expirationPreferences', null);
        let soonDays = 'soonDays';
        let soonRepeatDays = 'soonRepeatDays';
        let expiredRepeatDays = 'expiredRepeatDays';
        let minSoonDays = 1;
        let maxSoonDays = 60;
        let neverRepeat = 0;
        let maxRepeatDays = 30;
        return preferences == null
            || (preferences is map
                && preferences.keys().hasOnly([soonDays, soonRepeatDays, expiredRepeatDays])
                && optionalIntInRange(preferences, soonDays, minSoonDays, maxSoonDays)
                && optionalIntInRange(preferences, soonRepeatDays, neverRepeat, maxRepeatDays)
                && optionalIntInRange(preferences, expiredRepeatDays, neverRepeat, maxRepeatDays));
      }

      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
          && request.auth.uid == userId
          && hasValidExpirationPreferences(request.resource.data);
    }

    // Private receipt handoff, not an expense ledger or trusted financial proof. The immutable
    // marker is created in the inventory batch, so replays cannot overwrite existing inventory.
    match /users/{userId}/inventorySubmissions/{submissionId} {
      function validSubmission() {
        let data = request.resource.data;
        let household = get(householdPath(data.householdId)).data;
        let submissionFields = ['id', 'ownerId', 'householdId', 'rows'];
        let maxRows = 100;
        return data.keys().hasOnly(submissionFields)
            && data.keys().hasAll(submissionFields)
            && submissionId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
            && data.id == submissionId && data.ownerId == userId
            && data.householdId is string
            && household.type == sharedFridgeType() && request.auth.uid in household.memberIds
            && data.rows is list && data.rows.size() > 0 && data.rows.size() <= maxRows;
      }

      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && validSubmission();
      allow update, delete: if false;
    }

    // A public profile is readable by its owner and by the members of the owner's household.
    // Only one document at a time: profiles cannot be listed, so they cannot be enumerated.
    match /profiles/{userId} {
      // Membership is read from the household's memberIds, the source of truth; the reader's
      // own user document only says which household to check.
      function sharesHouseholdWith(otherId) {
        let householdId = get(documentPath('users', request.auth.uid)).data.get('householdId', null);
        let members = get(householdPath(householdId)).data.memberIds;
        return householdId is string && request.auth.uid in members && otherId in members;
      }

      function optionalString(data, field) {
        return !(field in data) || data[field] == null || data[field] is string;
      }

      // The email, when present, must be the signed-in account's own address.
      function isValidProfile(data) {
        let maxPseudoLength = 40;
        return data.keys().hasOnly(['displayName', 'photoUrl', 'email'])
            && optionalString(data, 'displayName')
            // Regex counts Unicode code points; size() counts UTF-16 code units.
            && (data.get('displayName', null) == null
                || data.displayName.matches('(?s).{0,' + string(maxPseudoLength) + '}'))
            && optionalString(data, 'photoUrl')
            && optionalString(data, 'email')
            && (!('email' in data) || data.email == null
                || data.email == request.auth.token.get('email', null));
      }

      allow get: if signedIn()
          && (request.auth.uid == userId || sharesHouseholdWith(userId));
      allow create, update: if signedIn()
          && request.auth.uid == userId
          && isValidProfile(request.resource.data);
      allow delete: if false;
    }

    // Pseudo claims are addressed by a normalized-name hash and cannot be enumerated.
    match /pseudoClaims/{claimId} {
      function ownsExistingClaim() {
        return resource.data.get('uid', null) == request.auth.uid
            || request.auth.uid in resource.data.get('legacyUids', []);
      }

      allow get: if signedIn()
          && (!exists(documentPath('pseudoClaims', claimId)) || ownsExistingClaim());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && !exists(documentPath('pseudoClaims', claimId));
      allow list, update: if false;
      allow delete: if signedIn() && resource.data.get('uid', null) == request.auth.uid;
    }

    // Codes only exist for shared fridges, so anyone who knows one can fetch it.
    // Codes cannot be listed, so they cannot be enumerated. Codes are immutable.
    match /inviteCodes/{code} {
      function pointsToOwnHousehold() {
        let household = getAfter(householdPath(request.resource.data.householdId));
        return household.data.type == sharedFridgeType()
            && household.data.createdBy == request.auth.uid && household.data.inviteCode == code;
      }

      // Missing codes remain readable for collision checks during household creation.
      allow get: if signedIn();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['householdId'])
          && request.resource.data.householdId is string
          && pointsToOwnHousehold();
    }

    match /households/{householdId} {
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }

      // Private fridges have no invite code. Shared codes must map back to this household.
      function hasValidInviteCode(household) {
        return (household.type == privateFridgeType() && household.inviteCode == '')
            || (household.type == sharedFridgeType()
                && household.inviteCode.size() > 0
                && getAfter(documentPath('inviteCodes', household.inviteCode)).data.householdId
                    == householdId);
      }

      // The creator is the only initial member; shared fridges also require an invite lookup.
      function isValidNewHousehold() {
        let household = request.resource.data;
        let fields = ['id', 'name', 'inviteCode', 'memberIds', 'createdBy', 'createdAt', 'type'];
        return household.keys().hasOnly(fields) && household.keys().hasAll(fields)
            && household.type in [privateFridgeType(), sharedFridgeType()]
            && household.id == householdId
            && household.name is string
            // Regex counts Unicode code points; size() counts UTF-16 code units. Keep the limit
            // in sync with TextLimits.HOUSEHOLD_NAME.
            && household.name.matches('(?s).{1,40}')
            && household.inviteCode is string
            && household.createdBy == request.auth.uid
            && household.memberIds == [request.auth.uid]
            && hasValidPrivateMembers(household)
            && household.createdAt is timestamp
            && hasValidInviteCode(household);
      }

      // Membership changes may touch memberIds and nothing else.
      function onlyMemberIdsChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }

      // Joining: a user may only append themselves to the members, and must point their own
      // profile at the household in the same batch, with the household's invite code as proof
      // that they were invited. Knowing the household ID alone is not enough. No other field can
      // change.
      function onlyAddsSelf() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        let profile = getAfter(documentPath('users', request.auth.uid)).data;
        return onlyMemberIdsChange()
            && (after == before
                || (!(request.auth.uid in before) && after == before.concat([request.auth.uid])
                    && profile.get('joinCode', null) == resource.data.inviteCode))
            && profile.householdId == householdId;
      }

      // Leaving: a member may only remove themselves, and must clear the household from their
      // own profile in the same batch, so it cannot be left pointing at this or any other
      // household. No other field can change.
      function onlyRemovesSelf() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return resource.data.type != privateFridgeType()
            && onlyMemberIdsChange()
            && request.auth.uid in before
            && after == before.removeAll([request.auth.uid])
            && getAfter(documentPath('users', request.auth.uid)).data.get('householdId', null)
                == null;
      }

      // Fetching a missing household is allowed so that lookups can return "not found".
      allow get: if signedIn() && (resource == null
          || (canAccessFridge(resource.data)
              && (resource.data.type == privateFridgeType() || isMember())));
      // Private memberships are restricted to the creator by every client write, so this cannot
      // expose a private fridge to another user. Admin-written private documents must preserve
      // that invariant.
      allow list: if signedIn() && isMember();
      allow create: if signedIn() && isValidNewHousehold();
      allow update: if signedIn() && canAccessFridge(resource.data)
          // Private fridges are immutable after creation, so identical creation replays cannot
          // relink the profile. Identical shared creation replays rewrite an immutable,
          // create-only inviteCodes document, rejecting the whole batch even when this household
          // update is a no-op.
          && resource.data.type == sharedFridgeType()
          && hasValidPrivateMembers(request.resource.data)
          && (onlyAddsSelf() || onlyRemovesSelf());
    }

    // Separate name-only directory: private /users documents stay owner-only.
    // Queries must select current member document IDs, never the whole directory.
    match /households/{householdId}/memberNames/{memberId} {
      function canReadName() {
        let household = get(householdPath(householdId)).data;
        return signedIn() && canAccessFridge(household)
            && request.auth.uid in household.memberIds && memberId in household.memberIds;
      }
      function validName() {
        let data = request.resource.data;
        let nameFields = ['displayName'];
        let maxNameLength = 80;
        return data.keys().hasOnly(nameFields) && data.keys().hasAll(nameFields)
            && data.displayName is string && data.displayName.size() > 0
            && data.displayName.size() <= maxNameLength && data.displayName.matches('[^@]+');
      }
      allow read: if canReadName();
      allow create, update: if canReadName() && request.auth.uid == memberId && validName();
      allow delete: if canReadName() && request.auth.uid == memberId;
    }

    // The authenticated expense callable writes expenses. Clients can only read them.
    match /households/{householdId}/expenses/{expenseId} {
      function canReadExpenses() {
        let household = get(householdPath(householdId)).data;
        return household.type == sharedFridgeType() && request.auth.uid in household.memberIds;
      }

      allow read: if signedIn() && canReadExpenses();
      allow write: if false;
    }

    // Only the settlement service writes immutable reimbursement records.
    match /households/{householdId}/settlements/{settlementId} {
      function canReadSettlements() {
        let household = get(householdPath(householdId)).data;
        return household.type == sharedFridgeType() && request.auth.uid in household.memberIds;
      }

      allow read: if signedIn() && canReadSettlements();
    }

    // Chat messages: shared household members can read and post as themselves. Messages are
    // immutable and never deleted by clients. Private fridges have no chat.
    match /households/{householdId}/messages/{messageId} {
      function canUseChat() {
        let household = get(householdPath(householdId)).data;
        return household.type == sharedFridgeType()
            && request.auth.uid in household.memberIds;
      }

      function isValidNewMessage() {
        let message = request.resource.data;
        return message.keys().hasOnly([
              'id', 'senderId', 'senderName', 'text', 'timestamp',
              'type', 'itemName', 'itemImageUrl'
            ])
            && message.keys().hasAll(['id', 'senderId', 'senderName', 'text', 'timestamp'])
            && message.id == messageId
            && message.senderId == request.auth.uid
            && message.senderName is string
            && message.text is string
            && message.timestamp is timestamp
            && (isValidTextMessage(message) || isValidActivityMessage(message));
      }

      function hasVisibleText(text) {
        return text.matches('[\\s\\S]*\\S[\\s\\S]*');
      }

      function isValidTextMessage(message) {
        let textType = 'TEXT';
        let maxTextLength = 2000;
        return message.get('type', textType) == textType
            && hasVisibleText(message.text)
            && message.text.size() <= maxTextLength
            && message.get('itemName', '') == ''
            && message.get('itemImageUrl', null) == null;
      }

      function isValidActivityMessage(message) {
        return message.get('type', null) in ['EATEN', 'THROWN']
            && message.text == ''
            && message.get('itemName', null) is string
            && hasVisibleText(message.itemName)
            && (message.get('itemImageUrl', null) == null
                || message.itemImageUrl is string);
      }

      allow read: if signedIn() && canUseChat();
      allow create: if signedIn() && canUseChat() && isValidNewMessage();
      allow update, delete: if false;
    }

    function isHouseholdMember(householdId) {
      let household = get(householdPath(householdId)).data;
      return householdId != null && canAccessFridge(household)
          && (household.type == privateFridgeType()
              || request.auth.uid in household.memberIds);
    }

    // Helpers shared by items and receipts. They take the document data as a parameter.
    function isOwner(data) {
      return data.ownerId == request.auth.uid;
    }

    // Household-access predicate used by receipts; item sharing does not control read authorization
    // there.
    function isShared(data) {
      return data.get('householdId', null) != null && isHouseholdMember(data.householdId);
    }

    // Receipt documents must contain the fields the app expects; householdId is optional.
    function hasValidReceiptData(data) {
      return data.ownerId is string
          && data.storeName is string
          && data.storeName.size() > 0
          && data.totalAmountCents is number
          && data.totalAmountCents >= 0
          && (data.get('householdId', null) == null || data.householdId is string)
          && (data.get('date', null) == null || data.date is timestamp);
    }

    // A document is either private (no householdId) or shared with a household the writer is in.
    function isPrivateOrSharedWithMyHousehold(data) {
      return data.get('householdId', null) == null || isShared(data);
    }

    // Owner or household member can update. ownerId is immutable. householdId can only be
    // changed by the owner, and only to null or to a household the owner belongs to.
    function canUpdateReceipt(before, after) {
      return (isOwner(before) || isShared(before))
          && hasValidReceiptData(after)
          && after.ownerId == before.ownerId
          && (after.get('householdId', null) == before.get('householdId', null)
              || (isOwner(before) && isPrivateOrSharedWithMyHousehold(after)));
    }

    // ---- Items ----
    //
    // Every item belongs to exactly one household and is either PERSONAL (visible and editable
    // by its owner only) or SHARED (visible and editable by every current member).
    //
    // Access always follows the household's current memberIds, even for the owner: a user who
    // left a household can no longer read, change or delete any of its items, including their own.
    // Leaving never deletes items, so they are still there if the user is added back.
    // A private fridge has a single member, its creator, and can only hold PERSONAL items.

    // The caller currently belongs to the existing household [householdId].
    function isCurrentMember(householdId) {
      return householdId is string
          && householdId.size() > 0
          && exists(householdPath(householdId))
          && canAccessFridge(get(householdPath(householdId)).data)
          && request.auth.uid in get(householdPath(householdId)).data.memberIds;
    }

    function sharedItemSharing() {
      return 'SHARED';
    }

    function personalItemSharing() {
      return 'PERSONAL';
    }

    // PERSONAL is always allowed; SHARED only in a fridge that is not private.
    function sharingAllowedIn(householdId, sharing) {
      return sharing == personalItemSharing()
          || (sharing == sharedItemSharing()
              && get(householdPath(householdId)).data.type != privateFridgeType());
    }

    // Who may see, edit and delete an item: current members of its household, if the item is
    // theirs or shared. An item without a household is inaccessible.
    function canAccessItem(item) {
      return isCurrentMember(item.get('householdId', null))
          && (isOwner(item) || item.get('sharing', null) == sharedItemSharing());
    }

    // Keep the limits in sync with TextLimits.ITEM_NAME, TextLimits.ITEM_CATEGORY and
    // ItemQuantity.MAX. The regex counts Unicode code points; size() counts UTF-16 code units.
    function hasValidItemName(name) {
      return name is string && name.matches('(?s).{1,80}');
    }

    function hasValidItemCategory(category) {
      return category == null || (category is string && category.matches('(?s).{0,40}'));
    }

    function hasValidItemQuantity(quantity) {
      return quantity is int && quantity > 0 && quantity <= 9999;
    }

    // Item documents must contain the fields the app expects. Their household is checked where an
    // item is created (isCurrentMember) and cannot change afterwards (canUpdateItem).
    function hasValidItemData(data) {
      // Items saved before ItemQuantity.MAX existed may hold up to Kotlin's Int.MAX_VALUE.
      let maxStoredItemQuantity = 2147483647;
      let itemStatuses = ['ACTIVE', 'EATEN', 'DISCARDED'];
      return data.sharing in [sharedItemSharing(), personalItemSharing()]
          && data.quantity is int && data.quantity > 0 && data.quantity <= maxStoredItemQuantity
          && data.status in itemStatuses
          && data.ownerId is string && data.ownerId.size() > 0
          && data.name is string
          && data.name.size() > 0
          && (data.get('expirationDate', null) == null || data.expirationDate is timestamp)
          && (data.get('category', null) == null || data.category is string);
    }

    // New and changed texts and quantities must fit their limits. An update that leaves a value as
    // it was is accepted, so an item saved before the limits existed can still change status or
    // sharing.
    function hasValidNewItemLimits(data) {
      return hasValidItemName(data.name) && hasValidItemCategory(data.get('category', null))
          && hasValidItemQuantity(data.quantity);
    }

    function hasValidChangedItemLimits(before, after) {
      return (after.name == before.name || hasValidItemName(after.name))
          && (after.get('category', null) == before.get('category', null)
              || hasValidItemCategory(after.get('category', null)))
          && (after.quantity == before.quantity || hasValidItemQuantity(after.quantity));
    }

    // ownerId and householdId are immutable (moving an item is not supported yet). Only the owner
    // may change the sharing, and never to SHARED in a private fridge.
    function canUpdateItem(before, after) {
      return canAccessItem(before)
          && hasValidItemData(after)
          && hasValidChangedItemLimits(before, after)
          && after.ownerId == before.ownerId
          && after.householdId == before.householdId
          && (after.sharing == before.sharing
              || (isOwner(before) && sharingAllowedIn(before.householdId, after.sharing)));
    }

    match /items/{itemId} {
      // Image transactions must be able to ignore an item deleted during a lookup.
      allow get: if signedIn() && resource == null;
      // Queries must filter on householdId and either sharing == 'SHARED' or ownerId == the
      // caller, otherwise they could return items the caller may not read and are rejected.
      allow read: if signedIn() && canAccessItem(resource.data);
      allow create: if signedIn()
          && hasValidItemData(request.resource.data)
          && hasValidNewItemLimits(request.resource.data)
          && isOwner(request.resource.data)
          && isCurrentMember(request.resource.data.householdId)
          && sharingAllowedIn(request.resource.data.householdId, request.resource.data.sharing);
      allow update: if signedIn() && canUpdateItem(resource.data, request.resource.data);
      // Shared items belong to the shared list: any current member can delete them. Deleting a
      // missing item is a harmless no-op.
      allow delete: if signedIn() && (resource == null || canAccessItem(resource.data));
    }

    match /receipts/{receiptId} {
      allow read: if signedIn() && (isOwner(resource.data) || isShared(resource.data));
      allow create: if signedIn()
          && hasValidReceiptData(request.resource.data)
          && isOwner(request.resource.data)
          && isPrivateOrSharedWithMyHousehold(request.resource.data);
      allow update: if signedIn() && canUpdateReceipt(resource.data, request.resource.data);
      // Receipts can only be deleted by their owner.
      allow delete: if signedIn() && isOwner(resource.data);
    }
  }
}
